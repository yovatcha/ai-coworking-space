# ── Vercel (frontend + API routes) ─────────────────────────────
# URL of your Render Socket.IO backend
NEXT_PUBLIC_SOCKET_URL=https://your-app.onrender.com

# Supabase — Transaction pooler (port 6543). Used at runtime.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Supabase — Session pooler (port 5432). Used by `prisma migrate`.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

OPENROUTER_API_KEY=

# One password per member — the password is what identifies who logs in.
# See docs/adr/0005-fixed-roster-member-colors.md
PASSWORD_YO=
PASSWORD_PHEE=
PASSWORD_TENT=
PASSWORD_ART=
PASSWORD_JOE=
PASSWORD_GUEST=

# Legacy: used as the Guest password when PASSWORD_GUEST is unset
ROOM_PASSWORD=

# ── Render (Socket.IO backend) ─────────────────────────────────
# Allow requests from your Vercel frontend
FRONTEND_URL=https://your-app.vercel.app

# PORT is injected by Render — do not set it manually
# PORT=3001
