# ── Vercel (frontend + API routes) ─────────────────────────────
# URL of your Render Socket.IO backend
NEXT_PUBLIC_SOCKET_URL=https://your-app.onrender.com

# Neon Postgres — provisioned through the Vercel Marketplace, which injects
# both of these automatically. Pull them with `vercel env pull`.
# Pooled connection (PgBouncer). Used at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection (no pooler). Used by `prisma migrate`.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

OPENROUTER_API_KEY=

# One password per member — the password is what identifies who logs in.
# See docs/adr/0005-fixed-roster-member-colors.md
PASSWORD_YO=
PASSWORD_PHEE=
PASSWORD_TENT=
PASSWORD_ART=
PASSWORD_JOE=
PASSWORD_GUEST=

# Legacy: used as the Guest password when PASSWORD_GUEST is unset
ROOM_PASSWORD=

# ── Render (Socket.IO backend) ─────────────────────────────────
# Allow requests from your Vercel frontend
FRONTEND_URL=https://your-app.vercel.app

# PORT is injected by Render — do not set it manually
# PORT=3001

# ── irin-task-board (announce board data) ─────────────────────
# Base URL of the irin-task-board deployment and the shared secret that
# matches its WORKLOAD_API_SECRET. See docs/adr/0007.
IRIN_TASK_BOARD_URL=https://irin-task-board.vercel.app
IRIN_TASK_BOARD_SECRET=
