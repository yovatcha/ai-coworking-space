generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Neon pooled connection (used at runtime)
  url       = env("DATABASE_URL")
  // Neon direct connection, no pooler (used by `prisma migrate`)
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  userId    String
  npcId     String
  role      String
  content   String
  createdAt DateTime @default(now())
}

model MemberColor {
  memberId  String   @id
  color     String
  updatedAt DateTime @updatedAt
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @default("")
  status      String   @default("active")
  docName     String   @default("")
  docText     String   @default("")
  addedBy     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Requirement {
  id        Int      @id @default(autoincrement())
  projectId Int
  text      String
  addedBy   String
  createdAt DateTime @default(now())
}

model SheetEntry {
  id        Int      @id @default(autoincrement())
  userId    String
  name      String
  sheetId   String
  scriptUrl String
  columns   String
  createdAt DateTime @default(now())
}
